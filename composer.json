{
  "name": "drupal/graphql",
  "type": "drupal-module",
  "description": "Exposes your Drupal data model through a GraphQL schema.",
  "homepage": "http://drupal.org/project/graphql",
  "license": "GPL-2.0+",
  "require": {
    "drupal/typed_data": "^1.0 || ^2.0",
    "php": ">=8.1",
    "webonyx/graphql-php": "^15.32.3"
  },
  "require-dev": {
    "drupal/entity_reference_revisions": "^1.14",
    "drupal/redirect": "^1.0",
    "phpstan/phpstan-deprecation-rules": "^2 || ^1",
    "jangregor/phpstan-prophecy": "^2 || ^1"
  }
}
